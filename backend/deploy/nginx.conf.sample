# 反向代理配置样例。
#
# 这个文件存在的唯一理由是下面那条 proxy_buffering off ——
# 应用层把流式做对了，反代缓冲一层照样把「流式」变成「慢的非流式」，
# 而排查时会先怀疑应用层，白花一天（ARCHITECTURE.md §6.1、IMPLEMENTATION-PLAN.md I0-X4）。

upstream umaas_control {
    server 127.0.0.1:8080;
    keepalive 32;
}

upstream umaas_data {
    server 127.0.0.1:8081;
    keepalive 64;
}

server {
    listen 443 ssl http2;
    server_name api.example.com;

    # ── 控制平面 ──────────────────────────────────────────────
    location /api/v1/ {
        proxy_pass http://umaas_control;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id      $request_id;
        proxy_read_timeout 60s;
    }

    # ── 推理数据平面 ──────────────────────────────────────────
    location /v1/ {
        proxy_pass http://umaas_data;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";

        # ★ 这三条是流式转发的前提，缺一不可
        proxy_buffering off;        # 不缓冲响应体，chunk 立即下发
        proxy_cache off;
        chunked_transfer_encoding on;

        # 推理请求可以跑几分钟，读超时必须放宽；
        # 但 send_timeout 是两次写之间的间隔，不是总时长，保持较短即可。
        proxy_read_timeout 600s;
        proxy_send_timeout 60s;
    }

    # /metrics 不对公网暴露，只允许内网抓取。
    location /metrics {
        deny all;
    }
}

# admin 建议单独域名或 IP 白名单，不与公网门户同域暴露（ARCHITECTURE.md §8）。
server {
    listen 443 ssl http2;
    server_name admin.internal.example.com;

    allow 10.0.0.0/8;
    deny all;

    location /api/v1/admin/ {
        proxy_pass http://umaas_control;
        proxy_http_version 1.1;
        proxy_set_header Host         $host;
        proxy_set_header X-Real-IP    $remote_addr;
        proxy_set_header X-Request-Id $request_id;
    }
}
